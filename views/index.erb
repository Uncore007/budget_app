<%
  total_weight  = @savings_allocations.sum { |a| a[:weight] }.to_f
  total_savings = @savings_allocations.sum { |a|
    pct = total_weight > 0 ? a[:weight] / total_weight : 0
    pct * @savings_pool
  }
  remaining = @savings_pool - total_savings
%>

<div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
  <div class="bg-white rounded-xl ring-1 ring-slate-900/5 shadow-sm p-6 text-center">
    <p class="text-xs font-medium text-slate-400 uppercase tracking-widest mb-2">Net Income</p>
    <p class="text-2xl font-bold text-emerald-600">$<%= "%.2f" % @total_income %></p>
  </div>
  <div class="bg-white rounded-xl ring-1 ring-slate-900/5 shadow-sm p-6 text-center">
    <p class="text-xs font-medium text-slate-400 uppercase tracking-widest mb-2">Expenses</p>
    <p class="text-2xl font-bold text-red-500">$<%= "%.2f" % @total_expenses %></p>
  </div>
  <div class="bg-white rounded-xl ring-1 ring-slate-900/5 shadow-sm p-6 text-center">
    <p class="text-xs font-medium text-slate-400 uppercase tracking-widest mb-2">Savings</p>
    <p class="text-2xl font-bold text-indigo-600">$<%= "%.2f" % total_savings %></p>
  </div>
  <div class="bg-white rounded-xl ring-1 ring-slate-900/5 shadow-sm p-6 text-center">
    <p class="text-xs font-medium text-slate-400 uppercase tracking-widest mb-2">Remaining</p>
    <p class="text-2xl font-bold <%= remaining >= 0 ? 'text-emerald-600' : 'text-red-500' %>">$<%= "%.2f" % remaining %></p>
  </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-5 gap-4 mb-6">
  <div class="md:col-span-2 bg-white rounded-xl ring-1 ring-slate-900/5 shadow-sm">
    <div class="px-6 py-4 border-b border-slate-100">
      <h2 class="text-sm font-semibold text-slate-900">Budget Flow</h2>
    </div>
    <div class="px-6 py-5 space-y-3 text-sm">
      <div class="flex justify-between">
        <span class="text-slate-500">Net Income</span>
        <span class="font-medium">$<%= "%.2f" % @total_income %></span>
      </div>
      <% if @tithe_rate > 0 %>
        <div class="flex justify-between">
          <span class="text-slate-500">Tithe (<%= (@tithe_rate * 100).round(1) %>%)</span>
          <span class="font-medium text-red-500">−$<%= "%.2f" % @tithe %></span>
        </div>
        <div class="border-t border-slate-100 pt-3 flex justify-between">
          <span class="text-slate-500">After Tithe</span>
          <span class="font-medium">$<%= "%.2f" % (@total_income - @tithe) %></span>
        </div>
        <div class="flex justify-between">
      <% else %>
        <div class="border-t border-slate-100 pt-3 flex justify-between">
      <% end %>
          <span class="text-slate-500">Expenses</span>
          <span class="font-medium text-red-500">−$<%= "%.2f" % @total_expenses %></span>
        </div>
      <div class="border-t border-slate-100 pt-3 flex justify-between">
        <span class="text-slate-500">Available for Savings</span>
        <span class="font-medium">$<%= "%.2f" % @savings_pool %></span>
      </div>
      <div class="flex justify-between">
        <span class="text-slate-500">Allocated to Savings</span>
        <span class="font-medium text-red-500">−$<%= "%.2f" % total_savings %></span>
      </div>
      <div class="border-t border-slate-100 pt-3 flex justify-between">
        <span class="font-semibold">Remaining</span>
        <span class="font-semibold <%= remaining >= 0 ? 'text-emerald-600' : 'text-red-500' %>">$<%= "%.2f" % remaining %></span>
      </div>
    </div>
  </div>

  <div class="md:col-span-3 bg-white rounded-xl ring-1 ring-slate-900/5 shadow-sm">
    <div class="px-6 py-4 border-b border-slate-100">
      <h2 class="text-sm font-semibold text-slate-900">Savings Breakdown</h2>
    </div>
    <div class="px-6 py-5">
      <% if @savings_allocations.empty? %>
        <p class="text-sm text-slate-400">No savings allocations yet. <a href="/savings" class="text-indigo-600 hover:underline">Add one.</a></p>
      <% else %>
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-slate-100 text-left">
              <th class="pb-3 text-xs font-medium text-slate-400 uppercase tracking-wider">Name</th>
              <th class="pb-3 text-xs font-medium text-slate-400 uppercase tracking-wider text-right">Rate</th>
              <th class="pb-3 text-xs font-medium text-slate-400 uppercase tracking-wider text-right">Amount</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-50">
            <% @savings_allocations.each do |a| %>
              <% a_pct = total_weight > 0 ? (a[:weight] / total_weight * 100).round(1) : 0 %>
              <tr>
                <td class="py-3 text-slate-900"><%= a[:name] %></td>
                <td class="py-3 text-right text-slate-500"><%= a_pct %>%</td>
                <td class="py-3 text-right font-medium">$<%= "%.2f" % (a_pct / 100.0 * @savings_pool) %></td>
              </tr>
            <% end %>
          </tbody>
          <tfoot class="border-t border-slate-200">
            <tr>
              <td class="pt-3 font-semibold">Total</td>
              <td class="pt-3 text-right font-semibold">100%</td>
              <td class="pt-3 text-right font-semibold">$<%= "%.2f" % total_savings %></td>
            </tr>
          </tfoot>
        </table>
      <% end %>
    </div>
  </div>
</div>

<%
  palette        = %w[#6366f1 #06b6d4 #10b981 #f59e0b #f43f5e #8b5cf6]
  exp_palette    = %w[#6366f1 #06b6d4 #10b981 #f59e0b #f43f5e #8b5cf6 #ec4899 #14b8a6]
  savings_names  = @savings_allocations.map { |a| a[:name] }
  savings_vals   = @savings_allocations.map { |a|
    pct = total_weight > 0 ? a[:weight] / total_weight : 0
    (pct * @savings_pool).round(2)
  }
  savings_colors = @savings_allocations.each_with_index.map { |_, i| palette[i % palette.length] }
  donut_labels   = ["Expenses"] + savings_names + ["Remaining"]
  donut_vals     = [@total_expenses.round(2)] + savings_vals + [[remaining, 0].max.round(2)]
  donut_colors   = ["#ef4444"] + savings_colors + ["#10b981"]

  cat_totals = @categories.each_with_index.map do |cat, i|
    total = @expense_items.select { |item| item[:expense_category_id] == cat[:id] }.sum { |item| item[:amount] }
    { name: cat[:name], total: total, color: exp_palette[i % exp_palette.length] }
  end.select { |c| c[:total] > 0 }
%>

<div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
  <div class="bg-white rounded-xl ring-1 ring-slate-900/5 shadow-sm">
    <div class="px-6 py-4 border-b border-slate-100">
      <h2 class="text-sm font-semibold text-slate-900">Where Your Money Goes</h2>
    </div>
    <div class="px-6 py-6 flex items-center justify-center" style="min-height:280px">
      <canvas id="incomeChart"></canvas>
    </div>
  </div>

  <% unless cat_totals.empty? %>
  <div class="bg-white rounded-xl ring-1 ring-slate-900/5 shadow-sm">
    <div class="px-6 py-4 border-b border-slate-100">
      <h2 class="text-sm font-semibold text-slate-900">Expenses by Category</h2>
    </div>
    <div class="px-6 py-6 flex items-center justify-center" style="min-height:280px">
      <canvas id="expenseDonut"></canvas>
    </div>
  </div>
  <% end %>

  <% unless @savings_allocations.empty? %>
  <div class="bg-white rounded-xl ring-1 ring-slate-900/5 shadow-sm">
    <div class="px-6 py-4 border-b border-slate-100">
      <h2 class="text-sm font-semibold text-slate-900">Savings Allocations</h2>
    </div>
    <div class="px-6 py-6 flex items-center justify-center" style="min-height:280px">
      <canvas id="savingsChart"></canvas>
    </div>
  </div>
  <% end %>
</div>

<script>
  Chart.defaults.font.family = 'ui-sans-serif, system-ui, sans-serif';
  Chart.defaults.color = '#94a3b8';

  new Chart(document.getElementById('incomeChart'), {
    type: 'doughnut',
    data: {
      labels: <%= donut_labels.to_json %>,
      datasets: [{
        data: <%= donut_vals.to_json %>,
        backgroundColor: <%= donut_colors.to_json %>,
        borderWidth: 3,
        borderColor: '#fff'
      }]
    },
    options: {
      cutout: '68%',
      plugins: {
        legend: { position: 'bottom', labels: { boxWidth: 10, padding: 16, font: { size: 12 } } },
        tooltip: { callbacks: { label: c => ' $' + c.parsed.toFixed(2) } }
      }
    }
  });

  <% unless cat_totals.empty? %>
  new Chart(document.getElementById('expenseDonut'), {
    type: 'doughnut',
    data: {
      labels: <%= cat_totals.map { |c| c[:name] }.to_json %>,
      datasets: [{
        data:            <%= cat_totals.map { |c| c[:total].round(2) }.to_json %>,
        backgroundColor: <%= cat_totals.map { |c| c[:color] }.to_json %>,
        borderWidth: 3,
        borderColor: '#fff'
      }]
    },
    options: {
      cutout: '68%',
      plugins: {
        legend: { position: 'bottom', labels: { boxWidth: 10, padding: 16, font: { size: 12 } } },
        tooltip: { callbacks: { label: c => {
          const total = c.dataset.data.reduce((a, b) => a + b, 0);
          return ' ' + (c.parsed / total * 100).toFixed(1) + '%';
        }}}
      }
    }
  });
  <% end %>

  <% unless @savings_allocations.empty? %>
  new Chart(document.getElementById('savingsChart'), {
    type: 'bar',
    data: {
      labels: <%= savings_names.to_json %>,
      datasets: [{
        data: <%= savings_vals.to_json %>,
        backgroundColor: <%= savings_colors.to_json %>,
        borderRadius: 6,
        borderSkipped: false
      }]
    },
    options: {
      indexAxis: 'y',
      plugins: {
        legend: { display: false },
        tooltip: { callbacks: { label: c => ' $' + c.parsed.x.toFixed(2) } }
      },
      scales: {
        x: { ticks: { callback: v => '$' + v }, grid: { color: '#f1f5f9' } },
        y: { grid: { display: false } }
      }
    }
  });
  <% end %>
</script>
