<table class="table table-sm">
  <thead>
    <tr>
      <th>Name</th>
      <th>Rate</th>
      <th>Amount</th>
      <th></th>
    </tr>
  </thead>
  <tbody id="savings-rows">
    <% @savings_allocations.each do |allocation| %>
      <%= erb :savings_row, locals: { allocation: allocation, savings_pool: @savings_pool } %>
    <% end %>
  </tbody>
</table>

<form hx-post="/savings"
      hx-target="#savings-rows"
      hx-swap="beforeend"
      class="row g-2 mt-2">
  <div class="col">
    <input type="text" name="name" class="form-control form-control-sm" placeholder="Name" required>
  </div>
  <div class="col">
    <input type="number" name="rate" class="form-control form-control-sm" placeholder="Rate (e.g. 0.25)" step="0.01" min="0" max="1" required>
  </div>
  <div class="col-auto">
    <button type="submit" class="btn btn-sm btn-primary">Add</button>
  </div>
</form>
