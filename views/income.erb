<table class="table table-sm">
  <thead>
    <tr>
      <th>Name</th>
      <th>Gross</th>
      <th>Tax Rate</th>
      <th>Net</th>
      <th></th>
    </tr>
  </thead>
  <tbody id="income-rows">
    <% @income_sources.each do |source| %>
      <tr id="income-<%= source[:id] %>">
        <td><%= source[:name] %></td>
        <td>$<%= "%.2f" % source[:amount] %></td>
        <td><%= (source[:tax_rate] * 100).round(1) %>%</td>
        <td>$<%= "%.2f" % (source[:amount] * (1 - source[:tax_rate])) %></td>
        <td>
          <button class="btn btn-sm btn-danger"
            hx-delete="/income/<%= source[:id] %>"
            hx-target="#income-<%= source[:id] %>"
            hx-swap="outerHTML">
            Delete
          </button>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<form hx-post="/income"
      hx-target="#income-rows"
      hx-swap="beforeend"
      class="row g-2 mt-2">
  <div class="col">
    <input type="text" name="name" class="form-control form-control-sm" placeholder="Name" required>
  </div>
  <div class="col">
    <input type="number" name="amount" class="form-control form-control-sm" placeholder="Gross amount" step="0.01" required>
  </div>
  <div class="col">
    <input type="number" name="tax_rate" class="form-control form-control-sm" placeholder="Tax rate (e.g. 0.3)" step="0.01" min="0" max="1">
  </div>
  <div class="col-auto">
    <button type="submit" class="btn btn-sm btn-primary">Add</button>
  </div>
</form>
