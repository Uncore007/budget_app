<div class="mb-6">
  <h1 class="text-xl font-semibold text-slate-900">Income</h1>
  <p class="text-sm text-slate-500 mt-1">Track your gross income sources and tax rates.</p>
</div>

<div class="bg-white rounded-xl ring-1 ring-slate-900/5 shadow-sm">
  <div class="px-6 py-4 border-b border-slate-100">
    <h2 class="text-sm font-semibold text-slate-900">Income Sources</h2>
  </div>
  <div class="px-6 py-4">
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-slate-100 text-left">
          <th class="pb-3 text-xs font-medium text-slate-400 uppercase tracking-wider">Name</th>
          <th class="pb-3 text-xs font-medium text-slate-400 uppercase tracking-wider text-right">Gross</th>
          <th class="pb-3 text-xs font-medium text-slate-400 uppercase tracking-wider text-right">Tax Rate</th>
          <th class="pb-3 text-xs font-medium text-slate-400 uppercase tracking-wider text-right">Net</th>
          <th></th>
        </tr>
      </thead>
      <tbody id="income-rows" class="divide-y divide-slate-50">
        <% @income_sources.each do |source| %>
          <%= erb :income_row, locals: { source: source } %>
        <% end %>
      </tbody>
    </table>

    <form hx-post="/income"
          hx-target="#income-rows"
          hx-swap="beforeend"
          class="flex gap-3 mt-6 pt-5 border-t border-slate-100">
      <input type="text" name="name"
             class="flex-1 rounded-lg border border-slate-200 px-3 py-2 text-sm placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
             placeholder="Name" required>
      <input type="number" name="amount"
             class="w-36 rounded-lg border border-slate-200 px-3 py-2 text-sm placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
             placeholder="Gross amount" step="0.01" required>
      <div class="relative w-36">
        <input type="number" name="tax_rate"
               class="w-full rounded-lg border border-slate-200 px-3 py-2 pr-7 text-sm placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
               placeholder="Tax %" step="1" min="0" max="100">
        <span class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 text-sm pointer-events-none">%</span>
      </div>
      <button type="submit"
              class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors">
        Add
      </button>
    </form>
  </div>
</div>
