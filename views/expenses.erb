<% @categories.each do |category| %>
  <h6 class="mt-3 text-muted"><%= category[:name] %></h6>
  <table class="table table-sm">
    <thead>
      <tr>
        <th>Name</th>
        <th>Amount</th>
        <th></th>
      </tr>
    </thead>
    <tbody id="expense-category-<%= category[:id] %>">
      <% @expense_items.select { |i| i[:expense_category_id] == category[:id] }.each do |item| %>
        <%= erb :expense_row, locals: { item: item } %>
      <% end %>
    </tbody>
  </table>

  <form hx-post="/expenses"
        hx-target="#expense-category-<%= category[:id] %>"
        hx-swap="beforeend"
        class="row g-2 mb-3">
    <input type="hidden" name="expense_category_id" value="<%= category[:id] %>">
    <div class="col">
      <input type="text" name="name" class="form-control form-control-sm" placeholder="Name" required>
    </div>
    <div class="col">
      <input type="number" name="amount" class="form-control form-control-sm" placeholder="Amount" step="0.01" required>
    </div>
    <div class="col-auto">
      <button type="submit" class="btn btn-sm btn-primary">Add</button>
    </div>
  </form>
<% end %>
