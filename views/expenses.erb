<div class="mb-6">
  <h1 class="text-xl font-semibold text-slate-900">Expenses</h1>
  <p class="text-sm text-slate-500 mt-1">Track your monthly expenses by category.</p>
</div>

<div class="space-y-4">
<% @categories.each do |category| %>
  <div class="bg-white rounded-xl ring-1 ring-slate-900/5 shadow-sm">
    <div class="px-6 py-4 border-b border-slate-100">
      <h2 class="text-sm font-semibold text-slate-900"><%= category[:name] %></h2>
    </div>
    <div class="px-6 py-4">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-slate-100 text-left">
            <th class="pb-3 text-xs font-medium text-slate-400 uppercase tracking-wider">Name</th>
            <th class="pb-3 text-xs font-medium text-slate-400 uppercase tracking-wider text-right">Amount</th>
            <th></th>
          </tr>
        </thead>
        <tbody id="expense-category-<%= category[:id] %>" class="divide-y divide-slate-50">
          <% @expense_items.select { |i| i[:expense_category_id] == category[:id] }.each do |item| %>
            <%= erb :expense_row, locals: { item: item } %>
          <% end %>
        </tbody>
      </table>

      <form hx-post="/expenses"
            hx-target="#expense-category-<%= category[:id] %>"
            hx-swap="beforeend"
            class="flex gap-3 mt-4 pt-4 border-t border-slate-100">
        <input type="hidden" name="expense_category_id" value="<%= category[:id] %>">
        <input type="text" name="name"
               class="flex-1 rounded-lg border border-slate-200 px-3 py-2 text-sm placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
               placeholder="Name" required>
        <input type="number" name="amount"
               class="w-36 rounded-lg border border-slate-200 px-3 py-2 text-sm placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
               placeholder="Amount" step="0.01" required>
        <button type="submit"
                class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors">
          Add
        </button>
      </form>
    </div>
  </div>
<% end %>
</div>
